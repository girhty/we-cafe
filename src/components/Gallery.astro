---
interface Props { photos: string[] }
const { photos } = Astro.props;
const uniquePhotos = [...new Set(photos)];
---
<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6">
  {uniquePhotos.map((src, i) => (
    <div class="group relative overflow-hidden rounded-2xl shadow-sm aspect-[4/3] bg-brand-100">
      <img 
        src={src} 
        alt={`We cafe atmosphere photo ${i + 1}`} 
        class="w-full h-full object-cover group-hover:scale-110 transition duration-700 ease-in-out" 
        loading={i > 3 ? "lazy" : "eager"} 
      />
      <div class="absolute inset-0 bg-gradient-to-t from-brand-900/60 to-transparent opacity-0 group-hover:opacity-100 transition duration-300 flex items-end p-4">
        <span class="text-white font-semibold text-sm tracking-wide">View Moment</span>
      </div>
    </div>
  ))}
</div>