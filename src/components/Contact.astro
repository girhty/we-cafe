---
interface Props { cafe: any }
const { cafe } = Astro.props;
const telLink = cafe.phone.replace(/\s/g, '');
---
<section id="contact" class="py-24 bg-white">
  <div class="container mx-auto px-6 max-w-6xl">
    <h2 class="text-4xl md:text-5xl font-extrabold text-center mb-16">Visit Us Today</h2>
    <div class="grid md:grid-cols-2 gap-0 bg-brand-50 rounded-[2.5rem] overflow-hidden shadow-lg border border-brand-100">
      <div class="p-10 md:p-16 flex flex-col justify-center">
        <h3 class="text-3xl font-bold mb-8 text-brand-900">{cafe.name}</h3>
        <ul class="space-y-6 text-lg text-gray-700 mb-10">
          <li class="flex items-start gap-4">
            <span class="text-2xl" aria-hidden="true">📍</span>
            <span>{cafe.address}</span>
          </li>
          <li class="flex items-start gap-4">
            <span class="text-2xl" aria-hidden="true">📞</span>
            <a href={`tel:${telLink}`} class="hover:text-brand-accent font-semibold underline underline-offset-4 transition">{cafe.phone}</a>
          </li>
          <li class="flex items-start gap-4">
            <span class="text-2xl" aria-hidden="true">🕒</span>
            <span>Open daily — Great times await! Call ahead for peak match hours.</span>
          </li>
        </ul>
        <a href={`tel:${telLink}`} class="inline-block bg-brand-900 hover:bg-black text-white px-10 py-4 rounded-full font-bold text-center transition shadow-md self-start">Call to Reserve</a>
      </div>
      <div class="h-80 md:h-auto min-h-[400px] w-full bg-gray-200 relative">
        <iframe 
          title="Map showing location of We cafe"
          width="100%" 
          height="100%" 
          class="absolute inset-0"
          style="border:0;" 
          loading="lazy" 
          allowfullscreen
          src={`https://maps.google.com/maps?q=${encodeURIComponent(cafe.address)}&z=15&output=embed`}>
        </iframe>
      </div>
    </div>
  </div>
</section>